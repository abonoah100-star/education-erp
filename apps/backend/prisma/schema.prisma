generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CashboxStatus {
  ACTIVE
  CLOSED
}

enum CardType {
  STUDENT
  GUARDIAN
  TEACHER
  STAFF
}

enum SmartCardStatus {
  DRAFT
  IN_STOCK
  ASSIGNED
  ACTIVE
  SUSPENDED
  LOST
  DAMAGED
  REPLACED
  EXPIRED
  REVOKED
}

enum CardCodeFormat {
  QR
  BARCODE
  QR_AND_BARCODE
}

enum BarcodeType {
  CODE128
}

enum CardBatchStatus {
  DRAFT
  GENERATED
  PARTIALLY_ASSIGNED
  COMPLETED
  ARCHIVED
}

enum CardPrintStatus {
  DRAFT
  GENERATED
  PRINTED
  FAILED
}

enum CardPrintLayout {
  SINGLE
  A4_8_UP
  A4_10_UP
}

enum CardPrintSide {
  FRONT
  BACK
  BOTH
}

enum CardEventType {
  CREATED
  STOCKED
  ASSIGNED
  ACTIVATED
  IMAGE_GENERATED
  PRINTED
  SUSPENDED
  REVOKED
  REPLACED
  MARKED_LOST
  MARKED_DAMAGED
  EXPIRED
}


enum StudentStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  WITHDRAWN
  GRADUATED
  ARCHIVED
}

enum StudentGender {
  MALE
  FEMALE
}

enum GuardianStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum GuardianRelationship {
  FATHER
  MOTHER
  LEGAL_GUARDIAN
  GRANDFATHER
  GRANDMOTHER
  SIBLING
  OTHER
}

enum AuthorizedPickupStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum StudentDocumentType {
  BIRTH_CERTIFICATE
  GUARDIAN_ID
  STUDENT_PHOTO
  MEDICAL_REPORT
  ENROLLMENT_FORM
  OTHER
}

enum StudentNoteCategory {
  GENERAL
  ADMINISTRATIVE
  ACADEMIC
  HEALTH
  BEHAVIORAL
}

enum ProfileSequenceType {
  STUDENT
  GUARDIAN
  AUTHORIZED_PICKUP
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  systemName         String   @default("EduCore ERP")
  cardSubtitle       String?
  cardBackTitle      String?
  cardBackInstruction String?
  cardBackFooter     String?
  code               String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches      Branch[]
  users         User[]
  roles         Role[]
  cardTemplates CardTemplate[]
  cardBatches   CardBatch[]
  cards         QrCard[]
  cardPrintJobs     CardPrintJob[]
  cardSequences     CardSequence[]
  portraitAssets    CardPortraitAsset[]
  brandAsset        OrganizationBrandAsset?
  profileSequences  ProfileSequence[]
  personPhotoAssets PersonPhotoAsset[]
  students           Student[]
  guardians          Guardian[]
  authorizedPickups  AuthorizedPickup[]
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  code           String
  address        String?
  phone          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  cashboxes     Cashbox[]
  memberships   UserBranch[]
  cardTemplates CardTemplate[]
  cardBatches   CardBatch[]
  cards         QrCard[]
  cardPrintJobs CardPrintJob[]
  students      Student[]

  @@unique([organizationId, code])
}

model Cashbox {
  id        String        @id @default(uuid())
  branchId  String
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name      String
  code      String
  balance   Decimal       @default(0) @db.Decimal(14, 2)
  status    CashboxStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([branchId, code])
}

model User {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name             String
  email            String       @unique
  passwordHash     String
  status           UserStatus   @default(ACTIVE)
  refreshTokenHash String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  roleLinks   UserRole[]
  branchLinks UserBranch[]
  auditLogs                AuditLog[]             @relation("AuditActor")
  cardEvents               CardEvent[]            @relation("CardEventActor")
  uploadedStudentDocuments StudentDocument[]      @relation("StudentDocumentUploader")
  authoredStudentNotes     StudentNote[]          @relation("StudentNoteAuthor")
  studentStatusChanges     StudentStatusHistory[] @relation("StudentStatusActor")
}

model Role {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  code           String
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  userLinks       UserRole[]
  permissionLinks RolePermission[]

  @@unique([organizationId, code])
}

model Permission {
  id     String @id @default(uuid())
  code   String @unique
  name   String
  module String

  roleLinks RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserBranch {
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model CardSequence {
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cardType          CardType
  lastCardNumber    Int          @default(0)
  lastSubjectNumber Int          @default(0)
  updatedAt         DateTime     @updatedAt

  @@id([organizationId, cardType])
}

model OrganizationBrandAsset {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mimeType       String
  byteSize       Int
  sha256         String
  content        Bytes
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model CardPortraitAsset {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mimeType       String
  byteSize       Int
  sha256         String
  content        Bytes
  createdAt      DateTime     @default(now())

  cards QrCard[]

  @@unique([organizationId, sha256])
  @@index([organizationId, createdAt])
}

model CardTemplate {
  id                   String         @id @default(uuid())
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branchId             String?
  branch               Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name                 String
  code                 String
  cardType             CardType
  description          String?
  backgroundColor      String         @default("#0F3D32")
  accentColor          String         @default("#D9B56D")
  textColor            String         @default("#FFFFFF")
  mutedTextColor       String         @default("#DDE8E4")
  widthMm              Decimal        @default(85.60) @db.Decimal(6, 2)
  heightMm             Decimal        @default(53.98) @db.Decimal(6, 2)
  defaultCodeFormat    CardCodeFormat @default(QR_AND_BARCODE)
  defaultBarcodeType   BarcodeType    @default(CODE128)
  showPhoto            Boolean        @default(true)
  showBranch           Boolean        @default(true)
  showExpiry           Boolean        @default(false)
  frontLayout          Json
  backLayout           Json?
  isDefault            Boolean        @default(false)
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  cards       QrCard[]
  batches     CardBatch[]
  printJobs   CardPrintJob[]

  @@unique([organizationId, code])
  @@index([organizationId, cardType, isActive])
}

model CardBatch {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  templateId     String
  template       CardTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  name           String
  code           String
  cardType       CardType
  status         CardBatchStatus @default(DRAFT)
  prefix         String
  startNumber    Int
  quantity       Int
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  cards QrCard[]

  @@unique([organizationId, code])
  @@index([organizationId, branchId, status])
}

model QrCard {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branchId       String?
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  templateId     String?
  template       CardTemplate?   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  batchId        String?
  batch          CardBatch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  cardType       CardType
  subjectId      String?
  ownerName           String?
  portraitAssetId     String?
  portraitAsset       CardPortraitAsset? @relation(fields: [portraitAssetId], references: [id], onDelete: SetNull)
  studentId           String?
  student             Student?          @relation("StudentCards", fields: [studentId], references: [id], onDelete: SetNull)
  guardianId          String?
  guardian            Guardian?         @relation("GuardianCards", fields: [guardianId], references: [id], onDelete: SetNull)
  authorizedPickupId  String?
  authorizedPickup    AuthorizedPickup? @relation("AuthorizedPickupCards", fields: [authorizedPickupId], references: [id], onDelete: SetNull)
  publicCode          String          @unique
  secretHash     String
  codeFormat     CardCodeFormat  @default(QR_AND_BARCODE)
  barcodeType    BarcodeType     @default(CODE128)
  status         SmartCardStatus @default(ACTIVE)
  replacesCardId String?         @unique
  replacesCard   QrCard?         @relation("CardReplacement", fields: [replacesCardId], references: [id], onDelete: SetNull)
  replacement    QrCard?         @relation("CardReplacement")
  expiresAt      DateTime?
  assignedAt     DateTime?
  activatedAt    DateTime?
  printedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  events     CardEvent[]
  printItems CardPrintJobItem[]

  @@index([organizationId, branchId, cardType, status])
  @@index([organizationId, subjectId])
  @@index([portraitAssetId])
  @@index([studentId])
  @@index([guardianId])
  @@index([authorizedPickupId])
  @@index([batchId, status])
}

model CardEvent {
  id        String        @id @default(uuid())
  cardId    String
  card      QrCard        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?         @relation("CardEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  eventType CardEventType
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([cardId, createdAt])
}

model CardPrintJob {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branchId       String?
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  templateId     String?
  template       CardTemplate?   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  name           String
  status         CardPrintStatus @default(DRAFT)
  layout         CardPrintLayout @default(A4_8_UP)
  sideSelection  CardPrintSide   @default(FRONT)
  pageCount      Int             @default(1)
  createdAt      DateTime        @default(now())
  printedAt      DateTime?
  updatedAt      DateTime        @updatedAt

  items CardPrintJobItem[]

  @@index([organizationId, createdAt])
}

model CardPrintJobItem {
  printJobId String
  cardId     String
  position   Int

  printJob CardPrintJob @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  card     QrCard       @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@id([printJobId, cardId])
  @@unique([printJobId, position])
}

model ProfileSequence {
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profileType    ProfileSequenceType
  lastNumber     Int                 @default(0)
  updatedAt      DateTime            @updatedAt

  @@id([organizationId, profileType])
}

model PersonPhotoAsset {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mimeType       String
  byteSize       Int
  sha256         String
  content        Bytes
  createdAt      DateTime     @default(now())

  students          Student[]
  guardians         Guardian[]
  authorizedPickups AuthorizedPickup[]

  @@unique([organizationId, sha256])
  @@index([organizationId, createdAt])
}

model Student {
  id                  String        @id @default(uuid())
  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branchId            String
  branch              Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  code                String
  sequenceNumber      Int
  nameArabic          String
  normalizedName      String
  nameEnglish         String?
  gender              StudentGender?
  birthDate           DateTime?     @db.Date
  nationalId          String?
  schoolName          String?
  gradeLevel          String?
  phone               String?
  whatsappPhone       String?
  address             String?
  healthNotes         String?
  adminNotes          String?
  referralSource      String?
  profilePhotoAssetId String?
  profilePhotoAsset   PersonPhotoAsset? @relation(fields: [profilePhotoAssetId], references: [id], onDelete: SetNull)
  status              StudentStatus @default(ACTIVE)
  registeredAt        DateTime      @default(now())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  guardians         StudentGuardian[]
  authorizedPickups AuthorizedPickupStudent[]
  documents         StudentDocument[]
  notes             StudentNote[]
  statusHistory     StudentStatusHistory[]
  cards             QrCard[] @relation("StudentCards")

  @@unique([organizationId, code])
  @@unique([organizationId, sequenceNumber])
  @@unique([organizationId, nationalId])
  @@index([organizationId, branchId, status])
  @@index([organizationId, normalizedName])
  @@index([organizationId, schoolName, gradeLevel])
  @@index([organizationId, phone])
  @@index([organizationId, whatsappPhone])
  @@index([profilePhotoAssetId])
}

model Guardian {
  id                  String         @id @default(uuid())
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  code                String
  sequenceNumber      Int
  nameArabic          String
  normalizedName      String
  nameEnglish         String?
  nationalId          String?
  primaryPhone        String
  whatsappPhone       String?
  email               String?
  address             String?
  profilePhotoAssetId String?
  profilePhotoAsset   PersonPhotoAsset? @relation(fields: [profilePhotoAssetId], references: [id], onDelete: SetNull)
  status              GuardianStatus @default(ACTIVE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  students                  StudentGuardian[]
  authorizedPickupProfiles  AuthorizedPickup[]
  cards                     QrCard[] @relation("GuardianCards")

  @@unique([organizationId, code])
  @@unique([organizationId, sequenceNumber])
  @@unique([organizationId, nationalId])
  @@index([organizationId, normalizedName])
  @@index([organizationId, primaryPhone])
  @@index([organizationId, whatsappPhone])
  @@index([profilePhotoAssetId])
}

model StudentGuardian {
  studentId               String
  guardianId              String
  relationship            GuardianRelationship
  customRelationship      String?
  isPrimary               Boolean @default(false)
  isFinancialResponsible  Boolean @default(false)
  receivesNotifications   Boolean @default(true)
  canPickup               Boolean @default(true)
  isActive                Boolean @default(true)
  endedAt                 DateTime?
  endReason               String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId])
}

model AuthorizedPickup {
  id                  String                 @id @default(uuid())
  organizationId      String
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  code                String
  sequenceNumber      Int
  guardianId          String?
  guardian            Guardian?              @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  nameArabic          String
  normalizedName      String
  relationship        GuardianRelationship
  customRelationship  String?
  phone               String
  nationalId          String?
  profilePhotoAssetId String?
  profilePhotoAsset   PersonPhotoAsset?      @relation(fields: [profilePhotoAssetId], references: [id], onDelete: SetNull)
  status              AuthorizedPickupStatus @default(ACTIVE)
  validFrom           DateTime?              @db.Date
  validUntil          DateTime?              @db.Date
  securityNotes       String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  students AuthorizedPickupStudent[]
  cards    QrCard[] @relation("AuthorizedPickupCards")

  @@unique([organizationId, code])
  @@unique([organizationId, sequenceNumber])
  @@unique([organizationId, nationalId])
  @@index([organizationId, normalizedName])
  @@index([organizationId, phone])
  @@index([guardianId])
  @@index([profilePhotoAssetId])
}

model AuthorizedPickupStudent {
  authorizedPickupId String
  studentId          String
  isActive           Boolean  @default(true)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  authorizedPickup AuthorizedPickup @relation(fields: [authorizedPickupId], references: [id], onDelete: Cascade)
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([authorizedPickupId, studentId])
  @@index([studentId, isActive])
}

model StudentDocument {
  id           String              @id @default(uuid())
  studentId    String
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentType StudentDocumentType
  title        String
  fileName     String
  mimeType     String
  byteSize     Int
  sha256       String
  content      Bytes
  expiresAt    DateTime?           @db.Date
  isSensitive  Boolean             @default(false)
  uploadedById String?
  uploadedBy   User?               @relation("StudentDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([studentId, sha256])
  @@index([studentId, documentType])
  @@index([expiresAt])
  @@index([uploadedById])
}

model StudentNote {
  id          String              @id @default(uuid())
  studentId   String
  student     Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category    StudentNoteCategory @default(GENERAL)
  content     String
  isSensitive Boolean             @default(false)
  createdById String?
  createdBy   User?               @relation("StudentNoteAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([studentId, category, createdAt])
  @@index([createdById])
}

model StudentStatusHistory {
  id          String        @id @default(uuid())
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromStatus  StudentStatus?
  toStatus    StudentStatus
  reason      String?
  changedById String?
  changedBy   User?         @relation("StudentStatusActor", fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime      @default(now())

  @@index([studentId, changedAt])
  @@index([changedById])
}

