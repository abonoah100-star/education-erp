generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CashboxStatus {
  ACTIVE
  CLOSED
}

enum CardType {
  STUDENT
  GUARDIAN
  TEACHER
  STAFF
}

enum SmartCardStatus {
  DRAFT
  IN_STOCK
  ASSIGNED
  ACTIVE
  SUSPENDED
  LOST
  DAMAGED
  REPLACED
  EXPIRED
  REVOKED
}

enum CardCodeFormat {
  QR
  BARCODE
  QR_AND_BARCODE
}

enum BarcodeType {
  CODE128
}

enum CardBatchStatus {
  DRAFT
  GENERATED
  PARTIALLY_ASSIGNED
  COMPLETED
  ARCHIVED
}

enum CardPrintStatus {
  DRAFT
  GENERATED
  PRINTED
  FAILED
}

enum CardPrintLayout {
  SINGLE
  A4_8_UP
  A4_10_UP
}

enum CardEventType {
  CREATED
  STOCKED
  ASSIGNED
  ACTIVATED
  IMAGE_GENERATED
  PRINTED
  SUSPENDED
  REVOKED
  REPLACED
  MARKED_LOST
  MARKED_DAMAGED
  EXPIRED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches      Branch[]
  users         User[]
  roles         Role[]
  cardTemplates CardTemplate[]
  cardBatches   CardBatch[]
  cards         QrCard[]
  cardPrintJobs CardPrintJob[]
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  code           String
  address        String?
  phone          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  cashboxes     Cashbox[]
  memberships   UserBranch[]
  cardTemplates CardTemplate[]
  cardBatches   CardBatch[]
  cards         QrCard[]
  cardPrintJobs CardPrintJob[]

  @@unique([organizationId, code])
}

model Cashbox {
  id        String        @id @default(uuid())
  branchId  String
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name      String
  code      String
  balance   Decimal       @default(0) @db.Decimal(14, 2)
  status    CashboxStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([branchId, code])
}

model User {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name             String
  email            String       @unique
  passwordHash     String
  status           UserStatus   @default(ACTIVE)
  refreshTokenHash String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  roleLinks   UserRole[]
  branchLinks UserBranch[]
  auditLogs   AuditLog[]  @relation("AuditActor")
  cardEvents  CardEvent[] @relation("CardEventActor")
}

model Role {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  code           String
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  userLinks       UserRole[]
  permissionLinks RolePermission[]

  @@unique([organizationId, code])
}

model Permission {
  id     String @id @default(uuid())
  code   String @unique
  name   String
  module String

  roleLinks RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserBranch {
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model CardTemplate {
  id                   String         @id @default(uuid())
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branchId             String?
  branch               Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name                 String
  code                 String
  cardType             CardType
  description          String?
  backgroundColor      String         @default("#0F3D32")
  accentColor          String         @default("#D9B56D")
  textColor            String         @default("#FFFFFF")
  mutedTextColor       String         @default("#DDE8E4")
  widthMm              Decimal        @default(85.60) @db.Decimal(6, 2)
  heightMm             Decimal        @default(53.98) @db.Decimal(6, 2)
  defaultCodeFormat    CardCodeFormat @default(QR_AND_BARCODE)
  defaultBarcodeType   BarcodeType    @default(CODE128)
  showPhoto            Boolean        @default(true)
  showBranch           Boolean        @default(true)
  showExpiry           Boolean        @default(false)
  frontLayout          Json
  backLayout           Json?
  isDefault            Boolean        @default(false)
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  cards       QrCard[]
  batches     CardBatch[]
  printJobs   CardPrintJob[]

  @@unique([organizationId, code])
  @@index([organizationId, cardType, isActive])
}

model CardBatch {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  templateId     String
  template       CardTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  name           String
  code           String
  cardType       CardType
  status         CardBatchStatus @default(DRAFT)
  prefix         String
  startNumber    Int
  quantity       Int
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  cards QrCard[]

  @@unique([organizationId, code])
  @@index([organizationId, branchId, status])
}

model QrCard {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branchId       String?
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  templateId     String?
  template       CardTemplate?   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  batchId        String?
  batch          CardBatch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  cardType       CardType
  subjectId      String?
  ownerName      String?
  publicCode     String          @unique
  secretHash     String
  codeFormat     CardCodeFormat  @default(QR_AND_BARCODE)
  barcodeType    BarcodeType     @default(CODE128)
  status         SmartCardStatus @default(ACTIVE)
  replacesCardId String?         @unique
  replacesCard   QrCard?         @relation("CardReplacement", fields: [replacesCardId], references: [id], onDelete: SetNull)
  replacement    QrCard?         @relation("CardReplacement")
  expiresAt      DateTime?
  assignedAt     DateTime?
  activatedAt    DateTime?
  printedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  events     CardEvent[]
  printItems CardPrintJobItem[]

  @@index([organizationId, branchId, cardType, status])
  @@index([organizationId, subjectId])
  @@index([batchId, status])
}

model CardEvent {
  id        String        @id @default(uuid())
  cardId    String
  card      QrCard        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?         @relation("CardEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  eventType CardEventType
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([cardId, createdAt])
}

model CardPrintJob {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branchId       String?
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  templateId     String?
  template       CardTemplate?   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  name           String
  status         CardPrintStatus @default(DRAFT)
  layout         CardPrintLayout @default(A4_8_UP)
  pageCount      Int             @default(1)
  createdAt      DateTime        @default(now())
  printedAt      DateTime?
  updatedAt      DateTime        @updatedAt

  items CardPrintJobItem[]

  @@index([organizationId, createdAt])
}

model CardPrintJobItem {
  printJobId String
  cardId     String
  position   Int

  printJob CardPrintJob @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  card     QrCard       @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@id([printJobId, cardId])
  @@unique([printJobId, position])
}
